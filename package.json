{
  "name": "@xyb-community/anca-vasculitis-workbench",
  "version": "0.2.11",
  "description": "面向 ANCA 相关血管炎患者与照护者的本机病程资料工作台：ANCA 滴度（PR3/MPO）时间线、复发事件档案、免疫抑制用药版本链、激素副作用分节轨道",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "demo",
    "public",
    "schema",
    "research",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node scripts/build-client.mjs --check && node scripts/check-workbench-package.mjs . && node scripts/check-host-contract.mjs && node scripts/smoke-activate.mjs && node scripts/check-probe-coverage.mjs && node scripts/check-version-literal.mjs && node scripts/check-static-refs.mjs && node scripts/check-choice-limit.mjs && node scripts/check-schema-freeze.mjs && node scripts/check-write-schema.mjs && node scripts/check-wording.mjs . && node --test test/*.test.mjs",
    "check:version-literal": "node scripts/check-version-literal.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "check:static-refs": "node scripts/check-static-refs.mjs",
    "check:choice-limit": "node scripts/check-choice-limit.mjs",
    "smoke:activate": "node scripts/smoke-activate.mjs",
    "verify:desktop": "node scripts/verify-desktop-load.mjs",
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run test && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "check:primer": "node scripts/probe-disease-primer.mjs --url http://127.0.0.1:8251/index.html",
    "fetch:trials": "node scripts/fetch-anca-trials-2026.mjs",
    "fetch:trials:dry": "node scripts/fetch-anca-trials-2026.mjs --dry-run",
    "build:public": "node scripts/build-public.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build": "node scripts/build-public.mjs && node scripts/build-client.mjs",
    "serve": "node scripts/serve-dev.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/anca-vasculitis-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
